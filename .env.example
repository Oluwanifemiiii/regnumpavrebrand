# Copy this file to `.env.local`.
# The site talks to the Regnum reservations API (the staff app, on Neon Postgres).
# No database keys live in this project any more.
VITE_API_BASE=http://localhost:3100

# Web3Forms — emails you a copy of every submission (rooms, restaurant,
# boardroom, events, contact, availability). Get a free access key at
# https://web3forms.com (enter the inbox address to receive submissions).
# This key is public-safe by design. Leave blank to disable email notifications.
VITE_WEB3FORMS_KEY=

# Paystack — public key for the room booking deposit checkout. Find it in
# your Paystack dashboard: Settings → API Keys & Webhooks. This key is safe
# to ship in the client bundle.
VITE_PAYSTACK_PUBLIC_KEY=

# Payments + booking emails are now configured on the reservations API
# (apps/staff/.env.example in the front-desk repo): PAYSTACK_SECRET_KEY, RESEND_*.
