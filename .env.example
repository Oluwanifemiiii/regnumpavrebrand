# Copy this file to `.env.local` and fill in your Supabase project values.
# Find them in your Supabase dashboard: Project Settings → API.
# Only the "anon" public key belongs here — never the service_role key.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Web3Forms — emails you a copy of every submission (rooms, restaurant,
# boardroom, events, contact, availability). Get a free access key at
# https://web3forms.com (enter the inbox address to receive submissions).
# This key is public-safe by design. Leave blank to disable email notifications.
VITE_WEB3FORMS_KEY=
